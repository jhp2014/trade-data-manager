{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-dev",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set API_PORT=3011&& pnpm --filter @trade-data-manager/api dev"
      ],
      "port": 3011
    },
    {
      "name": "workbench-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@trade-data-manager/workbench",
        "dev",
        "--port",
        "3110",
        "--strictPort"
      ],
      "port": 3110
    }
  ]
}
