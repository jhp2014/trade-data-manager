{
    "name": "@trade-data-manager/lab-api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "tsx src/main.ts",
        "dev": "tsx watch src/main.ts",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rimraf dist",
        "clean:cache": "rimraf dist node_modules/.cache .turbo tsconfig.tsbuildinfo"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.5",
        "@trade-data-manager/persistence": "workspace:*",
        "@trade-data-manager/wire": "workspace:*",
        "hono": "^4.13.13"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "rimraf": "^6.0.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "vitest": "^2.1.9"
    }
}
