# @trade-data-manager/krx 가 요구하는 환경변수(이 패키지의 계약).
# 이 파일을 .env 로 복사해 채우면 패키지가 자급자족으로 로드한다.
# 소비 앱은 KRX 설정을 몰라도 됨 — createKrx() 가 여기서 알아서 읽는다.

# 인증키 — KRX 정보데이터시스템 OPEN API(openapi.krx.co.kr)에서 발급.
# 매 요청 헤더 AUTH_KEY 로 그대로 붙는다(토큰 발급 절차 없음). 한도 일 10,000건.
KRX_AUTH_KEY=your_auth_key_here

# 실데이터 호스트(기본값). 샘플은 .../svc/sample/apis 로 고정 응답만 준다.
# KRX_BASE_URL=https://data-dbg.krx.co.kr/svc/apis
